# Copie este archivo como .env.local y complete UNA de las opciones.

# Opción A: Gemini (configuración original)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=su-clave-de-aistudio.google.com

# Opción B: proveedor gratuito compatible con OpenAI
# Valores admitidos: groq, openrouter, mistral, cerebras, nvidia, llm7, huggingface
LLM_PROVIDER=groq
LLM_API_KEY=su-clave-gratuita
# Opcional: cambiar el modelo predeterminado del proveedor
# LLM_MODEL=llama-3.3-70b-versatile
# Opcional: cualquier otro proveedor de la lista (https://freellm.net)
# LLM_BASE_URL=https://api.deepseek.com/v1
